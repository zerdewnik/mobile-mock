  "shadow3d": {
    "card": [
      {
        "inset": true,
        "x": 0,
        "y": 1,
        "blur": 0,
        "color": "rgba(255,255,255,0.07)"
      },
      {
        "x": 0,
        "y": 4,
        "blur": 0,
        "color": "#0C0C10"
      },
      {
        "x": 0,
        "y": 10,
        "blur": 24,
        "color": "rgba(0,0,0,0.35)"
      }
    ],
    "button": [
      {
        "inset": true,
        "x": 0,
        "y": 1,
        "blur": 0,
        "color": "rgba(255,255,255,0.35)"
